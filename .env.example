# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Local data root (bronze / silver Parquet live here)
DATA_DIR=D:/capstone/data

# openFDA API key  (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# Snowflake — read by dbt (profiles.yml via env_var) and scripts/load_raw.py
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# AWS S3 — future bronze external stage (TR-09)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=
