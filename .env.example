# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Local data root (bronze / silver Parquet live here)
DATA_DIR=D:/capstone/data

# openFDA API key  (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# Snowflake — read by dbt (profiles.yml via env_var) and scripts/load_to_snowflake.py
# Key-pair auth: Snowflake deprecated password-only sign-ins (2026-08-18).
# Generate the key pair OUTSIDE this repo, then register the public half:
#   ALTER USER <user> SET RSA_PUBLIC_KEY='<public key, one line, no BEGIN/END headers>';
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=D:/capstone/.keys/rsa_key.p8

# AWS S3 — future bronze external stage (TR-09)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=

# Groq API key for the hosted answer generator (rag/generate/backends.py).
# Free plan: https://console.groq.com  The local Ollama backend needs no key.
GROQ_API_KEY=your_groq_api_key_here
