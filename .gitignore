# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p8
credentials*
secrets*
profiles.yml
!de_capstone/profiles.example.yml

# ---- data: never commit ----
data/
*.csv
*.json.gz
*.parquet
*.zip
!docs/**/*.json
!de_capstone/seeds/signal_worked_example.csv

# ---- python ----
.venv/
.venv-dbt/
.venv-app/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- dbt ----
de_capstone/target/
de_capstone/dbt_packages/
de_capstone/logs/
*.log

# ---- airflow ----
airflow/logs/
airflow.db
standalone_admin_password.txt

# ---- terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
